<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UiProject Condition="'$(UiProject)' == ''">../../development/Gurux.DLMS.UI.Net.csproj</UiProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../LayoutMetrics.cs" Link="LayoutMetrics.cs" />
    <Compile Include="../ButtonAuditMetrics.cs" Link="ButtonAuditMetrics.cs" />
    <ProjectReference Include="$(UiProject)" />
    <PackageReference Include="Gurux.DLMS" Version="9.0.2609.2201" GeneratePathProperty="true" ExcludeAssets="compile;runtime" />
    <Reference Include="Gurux.DLMS"><HintPath>$(PkgGurux_DLMS)/lib/net48/Gurux.DLMS.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
